{
  "name": "ichien",
  "version": "1.0.0",
  "description": "1 yen - jogo de uma tela em HTML/CSS/JS empacotado com Capacitor",
  "private": true,
  "scripts": {
    "serve": "npx --yes serve www -l 5173",
    "android:add": "cap add android",
    "sync": "cap sync",
    "open": "cap open android",
    "apk": "cd android && gradlew.bat assembleDebug",
    "aab": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
